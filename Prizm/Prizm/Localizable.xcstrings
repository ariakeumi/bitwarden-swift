    "On restart": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启"
          }
        }
      }
    },
    "On reopen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开"
          }
        }
      }
    },
    "Keep the vault unlocked, even after restarting your Mac. You can still lock it manually.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使重启电脑，也保持密码库解锁。你仍可随时手动锁定。"
          }
        }
      }
    },
    "Lock after restarting your Mac. Restarting Bitvault keeps the vault unlocked.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启电脑后锁定密码库。重启 App 后仍保持解锁。"
          }
        }
      }
    },
    "Lock after quitting and reopening Bitvault. Closing a window alone does not lock the vault.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出并重新打开 App 后锁定密码库。仅关闭窗口不会锁定。"
          }
        }
      }
    },
    "Could not save setting": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存设置"
          }
        }
      }
    },
    "Could not save the vault lock setting. Please try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存密码库锁定设置，请重试。"
          }
        }
      }
    },
    "Biometric unlock unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生物识别解锁暂不可用"
          }
        }
      }
    },
    "Biometric authentication is currently unavailable. If your Mac supports Touch ID, check that it is set up in System Settings and try again. You can still unlock your vault with your master password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前无法使用生物识别验证。如果你的 Mac 支持触控 ID，请确认已在系统设置中完成配置，然后重试。你仍可使用主密码解锁密码库。"
          }
        }
      }
    },
    "\"%@\" will be moved to Trash.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将被移到回收站。"
          }
        }
      }
    },
    "\"%@\" will be permanently deleted and cannot be recovered.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将被永久删除，且无法恢复。"
          }
        }
      }
    },
    "%@ or enter the password for %@ to unlock.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，或输入 %@ 的密码以解锁。"
          }
        }
      }
    },
