{
  "sourceLanguage": "en",
  "strings": {
    "%lld items selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择 %lld 项"
          }
        }
      }
    },
    "Right-click the selection to archive or move items to Trash.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点击所选项目以归档或移到回收站。"
          }
        }
      }
    },
    "%lld items will be moved to Trash.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个项目将被移到回收站。"
          }
        }
      }
    },
    "Archive Items?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档所选项目？"
          }
        }
      }
    },
    "%lld items will move to Archive and be hidden from your active vault and verification codes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个项目将被归档，并从当前密码库和验证码列表中隐藏。"
          }
        }
      }
    },
    "Sort": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排序"
          }
        }
      }
    },
